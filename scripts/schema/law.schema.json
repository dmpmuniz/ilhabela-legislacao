{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lei / norma municipal — schema v1.1",
  "type": "object",
  "required": ["id", "ref", "tipo", "ano", "cidade", "estado", "status", "titulo", "ementa", "url_fonte"],
  "properties": {
    "id": { "type": ["string", "integer"], "description": "Identificador estável do scraper (numérico na maioria do acervo)." },
    "ref": { "type": "string", "pattern": "^[a-z]{2,5}-\\d{4}-[a-z]{2,5}-\\d+[a-z]?(?:-\\d+)?$", "description": "Referência legível: {sigla}-{ano}-{tipo}-{numero}, com sufixo -2/-3 em colisões." },
    "tipo": { "type": "string", "enum": ["lei", "lei_complementar", "lei_organica", "decreto", "decreto_legislativo", "portaria", "portaria_conjunta", "resolucao", "emenda", "criado_pela_portaria,_de_03/09/1805"], "description": "Tipos normalizados; o registro histórico de 1805 mantém o rótulo bruto do portal." },
    "numero": { "type": ["integer", "string"], "description": "Inteiro; string apenas para sufixo de emenda (ex.: 2000/A). Ausente em atos sem número." },
    "ano": { "type": "integer", "minimum": 1800, "maximum": 2100, "description": "Ano da norma; 1805 é o registro histórico do município." },
    "cidade": { "type": "string" },
    "estado": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "esfera": { "type": "string", "enum": ["municipal", "estadual", "federal"] },
    "status": { "type": "string", "enum": ["em_vigor", "revogada", "inconstitucional", "suspensa", "expirada", "anulada"] },
    "data_vigencia": { "type": ["string", "null"], "format": "date" },
    "revogada_em": { "type": ["string", "null"], "format": "date" },
    "titulo": { "type": "string", "minLength": 5 },
    "ementa": { "type": "string", "minLength": 1 },
    "observacoes": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "palavras_chave": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "url_fonte": { "type": "string", "format": "uri" },
    "fonte_nome": { "type": "string" },
    "coletado_em": { "type": "string" },
    "validado_em": { "type": ["string", "null"] },
    "sha256_raw": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "referencias": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "relacao"],
        "properties": {
          "id": { "type": "string" },
          "artigo": { "type": "string" },
          "relacao": { "type": "string", "enum": ["revogada_por", "revoga", "altera", "citada_em", "referencia", "regulamenta", "deriva"] },
          "contexto": { "type": "string" }
        }
      }
    },
    "versao_formato": { "type": "string", "pattern": "^\\d+\\.\\d+$" }
  },
  "additionalProperties": true
}
